// ─────────────────────────────────────────────────────────────
// JharSankalp — Prisma Schema
// Societal Innovation Collaboration Platform for Jharkhand
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ─────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String
  phone          String?
  role           String   @default("CITIZEN") // CITIZEN, GOVERNMENT, UNIVERSITY, INDUSTRY, ADMIN
  organizationId String?
  isActive       Boolean  @default(true)
  avatarUrl      String?
  district       String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization?         @relation(fields: [organizationId], references: [id])
  submittedChallenges  Challenge[]           @relation("ChallengeSubmitter")
  submittedIdeas       Idea[]                @relation("IdeaSubmitter")
  collaborationsJoined CollaborationMember[]
  auditLogs            AuditLog[]
  notifications        Notification[]

  @@index([email])
  @@index([role])
  @@index([organizationId])
  @@map("users")
}

// ── Organization ─────────────────────────────────────────────

model Organization {
  id           String   @id @default(uuid())
  name         String
  type         String   // UNIVERSITY, COLLEGE, STARTUP, MSME, INDUSTRY, NGO, GOVERNMENT
  description  String?
  website      String?
  logoUrl      String?
  districtId   String?
  address      String?
  contactEmail String?
  contactPhone String?
  isVerified   Boolean  @default(false)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  district             District?            @relation(fields: [districtId], references: [id])
  users                User[]
  challenges           Challenge[]          @relation("ChallengeOrganization")
  ledProjects          Project[]            @relation("ProjectLeadOrganization")
  projectParticipations ProjectParticipant[]

  @@index([type])
  @@index([districtId])
  @@map("organizations")
}

// ── District ─────────────────────────────────────────────────

model District {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  stateCode String   @default("JH")
  createdAt DateTime @default(now())

  organizations Organization[]
  challenges    Challenge[]

  @@map("districts")
}

// ── Challenge ────────────────────────────────────────────────

model Challenge {
  id                      String   @id @default(uuid())
  publicId                String   @unique @default(uuid()) // Human-friendly tracking ID e.g. JS-2026-00024
  challengeCode           String?
  title                   String
  description             String
  sourceType              String   @default("CITIZEN")
  submittedById           String
  organizationId          String?
  status                  String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, VALIDATED, MATCHING, ACTIVE, IN_PROGRESS, RESOLVED
  actionTrack             String?
  domain                  String?  // Water Management, Agriculture, Mining Safety, Healthcare, Education, Environment
  subdomain               String?
  visibility              String   @default("PUBLIC")
  verificationStatus      String   @default("UNVERIFIED")
  moderationStatus        String   @default("SAFE")
  priority                String?  @default("MEDIUM")
  priorityScore           Float?
  priorityBreakdown       Json?
  innovationReadinessScore Float?
  readinessBreakdown      Json?
  districtId              String?
  block                   String?
  panchayatOrUlb          String?
  latitude                Float?
  longitude               Float?
  affectedPopulation      Int?
  severity                String?
  urgency                 String?
  aiAnalysis              Json?
  aiAnalyzedAt            DateTime?
  aiModelVersion          String?
  idempotencyKey          String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  submittedBy    User                @relation("ChallengeSubmitter", fields: [submittedById], references: [id])
  organization   Organization?       @relation("ChallengeOrganization", fields: [organizationId], references: [id])
  district       District?           @relation(fields: [districtId], references: [id])
  evidence       ChallengeEvidence[]
  ideas          Idea[]
  collaborations Collaboration[]
  solutions      Solution[]
  projects       Project[]

  @@index([status])
  @@index([sourceType])
  @@index([actionTrack])
  @@index([domain])
  @@index([districtId])
  @@index([submittedById])
  @@index([createdAt])
  @@map("challenges")
}

// ── Challenge Evidence ───────────────────────────────────────

model ChallengeEvidence {
  id          String   @id @default(uuid())
  challengeId String
  type        String   // IMAGE, DOCUMENT, AUDIO, VIDEO
  url         String
  filename    String
  mimeType    String
  sizeBytes   Int?
  metadata    Json?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@map("challenge_evidence")
}

// ── Idea ─────────────────────────────────────────────────────

model Idea {
  id                 String   @id @default(uuid())
  title              String
  description        String
  domain             String?  // Water Management, Agriculture, Mining Safety, Healthcare, Education, Environment
  district           String?
  status             String   @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, IN_COLLABORATION, IMPLEMENTED
  submittedById      String
  relatedChallengeId String?
  authorName         String?
  authorRole         String?
  supportersCount    Int      @default(0)
  collaboratorsCount Int      @default(0)
  tags               String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  submittedBy    User            @relation("IdeaSubmitter", fields: [submittedById], references: [id])
  challenge      Challenge?      @relation(fields: [relatedChallengeId], references: [id])
  collaborations Collaboration[]
  projects       Project[]

  @@index([status])
  @@index([domain])
  @@index([district])
  @@index([submittedById])
  @@index([relatedChallengeId])
  @@map("ideas")
}

// ── Collaboration ────────────────────────────────────────────

model Collaboration {
  id                   String   @id @default(uuid())
  title                String
  description          String
  status               String   @default("ACTIVE") // ACTIVE, RECRUITING, PLANNING, COMPLETED
  domain               String?
  district             String?
  stage                String?  @default("Concept") // Concept, Research, Prototype, Testing, Field Pilot, Deployment, Scaling
  progressPercentage   Int      @default(0)
  leadPartner          String?
  institutionName      String?
  relatedChallengeId   String?
  relatedIdeaId        String?
  neededSkills         String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  challenge Challenge?            @relation(fields: [relatedChallengeId], references: [id])
  idea      Idea?                 @relation(fields: [relatedIdeaId], references: [id])
  members   CollaborationMember[]
  solutions Solution[]

  @@index([status])
  @@index([domain])
  @@index([district])
  @@index([relatedChallengeId])
  @@index([relatedIdeaId])
  @@map("collaborations")
}

// ── Collaboration Member ─────────────────────────────────────

model CollaborationMember {
  id              String   @id @default(uuid())
  collaborationId String
  userId          String?
  memberName      String
  role            String   // LEAD, RESEARCHER, MENTOR, INDUSTRY_PARTNER, COMMUNITY_PARTNER
  institution     String?
  avatarUrl       String?
  joinedAt        DateTime @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([collaborationId])
  @@index([userId])
  @@map("collaboration_members")
}

// ── Solution ─────────────────────────────────────────────────

model Solution {
  id                     String   @id @default(uuid())
  title                  String
  tagline                String?
  description            String
  domain                 String
  district               String
  stage                  String   @default("FIELD_PILOT") // RESEARCH, PROTOTYPE, TESTING, FIELD_PILOT, DEPLOYMENT, SCALING
  technologyTags         String[] @default([])
  technologyType         String?
  progressPercentage     Int      @default(0)
  impactSummary          String?
  imageUrl               String?
  relatedChallengeId     String?
  relatedCollaborationId String?
  leadPartners           String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  challenge     Challenge?     @relation(fields: [relatedChallengeId], references: [id])
  collaboration Collaboration? @relation(fields: [relatedCollaborationId], references: [id])
  impactRecords ImpactRecord[]

  @@index([stage])
  @@index([domain])
  @@index([district])
  @@index([relatedChallengeId])
  @@index([relatedCollaborationId])
  @@map("solutions")
}

// ── Impact Record ────────────────────────────────────────────

model ImpactRecord {
  id          String   @id @default(uuid())
  solutionId  String?
  metricName  String   // e.g., "People Reached", "Villages Covered", "Response Time Reduction"
  metricValue String   // e.g., "12,400+", "14", "32%"
  metricUnit  String?
  district    String
  domain      String?
  description String?
  recordedAt  DateTime @default(now())

  solution Solution? @relation(fields: [solutionId], references: [id])

  @@index([solutionId])
  @@index([district])
  @@index([domain])
  @@map("impact_records")
}

// ── Audit Log ────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Notification ─────────────────────────────────────────────

model Notification {
  id         String   @id @default(uuid())
  userId     String
  event      String
  title      String
  message    String
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ── Project ──────────────────────────────────────────────────

model Project {
  id                 String    @id @default(uuid())
  referenceCode      String    @unique // e.g. PRJ-2026-0012
  title              String
  description        String
  challengeId        String?
  ideaId             String?
  leadOrganizationId String?
  domain             String?
  district           String?
  block              String?
  stage              String    @default("FORMATION") // FORMATION, RESEARCH_DESIGN, PROTOTYPE, LAB_TESTING, FIELD_PILOT, IMPLEMENTATION, IMPACT_VERIFICATION, SCALE
  status             String    @default("ACTIVE")    // ACTIVE, ON_HOLD, COMPLETED, DELAYED, CANCELLED
  startDate          DateTime?
  expectedEndDate    DateTime?
  affectedPopulation Int?
  locationDisplay    String?
  impactSummary      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  challenge        Challenge?          @relation(fields: [challengeId], references: [id])
  idea             Idea?               @relation(fields: [ideaId], references: [id])
  leadOrganization Organization?       @relation("ProjectLeadOrganization", fields: [leadOrganizationId], references: [id])
  participants     ProjectParticipant[]
  milestones       Milestone[]
  impactMetrics    ImpactMetric[]

  @@index([stage])
  @@index([status])
  @@index([domain])
  @@index([district])
  @@index([challengeId])
  @@index([leadOrganizationId])
  @@index([createdAt])
  @@map("projects")
}

// ── Project Participant ──────────────────────────────────────

model ProjectParticipant {
  id             String   @id @default(uuid())
  projectId      String
  organizationId String?
  userId         String?
  role           String   // LEAD, RESEARCH_PARTNER, TECHNICAL_PARTNER, FUNDING_PARTNER, MENTOR, IMPLEMENTATION_PARTNER, COMMUNITY_PARTNER
  contribution   String?
  createdAt      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([projectId])
  @@index([organizationId])
  @@map("project_participants")
}

// ── Milestone ────────────────────────────────────────────────

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, DELAYED
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("milestones")
}

// ── Impact Metric ────────────────────────────────────────────

model ImpactMetric {
  id            String   @id @default(uuid())
  projectId     String
  metricName    String
  baselineValue String?
  currentValue  String
  targetValue   String?
  unit          String
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("impact_metrics")
}

// ── Activity ─────────────────────────────────────────────────

model Activity {
  id             String   @id @default(uuid())
  type           String   // CHALLENGE_CREATED, IDEA_SUBMITTED, PROJECT_STARTED, MILESTONE_COMPLETED, IMPACT_RECORDED, STATUS_CHANGED
  message        String
  userId         String?
  organizationId String?
  challengeId    String?
  ideaId         String?
  projectId      String?
  createdAt      DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([projectId])
  @@index([challengeId])
  @@map("activities")
}

