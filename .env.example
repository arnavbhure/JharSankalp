# ──────────────────────────────────────────────
# JharSankalp — Environment Configuration
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://jharsankalp:jharsankalp@localhost:5432/jharsankalp?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# AI Configuration
# Options: mock | live | hybrid
AI_MODE=mock
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o

# Object Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=jharsankalp
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
